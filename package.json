{
  "name": "pc-optimizer-pro",
  "private": true,
  "version": "1.1.0",
  "description": "Professional Windows 10/11 PC Optimization Suite",
  "main": "electron/main.cjs",
  "author": "PC Optimizer Pro Systems",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "electron:dev": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --config.win.signAndEditExecutable=false",
    "dist:portable": "npm run build && electron-builder --win portable --x64 --config.win.signAndEditExecutable=false",
    "dist:setup": "npm run build && electron-builder --win nsis --x64 --config.win.signAndEditExecutable=false",
    "pack:from-unpacked": "electron-builder --win portable nsis --x64 --prepackaged release/win-unpacked --config.win.signAndEditExecutable=false",
    "clean": "rimraf dist release || rd /s /q dist release 2>nul || true"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/express": "^4.17.21",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pcoptimizer.pro",
    "productName": "PC Optimizer Pro",
    "copyright": "Copyright © PC Optimizer Pro Systems",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": false,
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false,
      "signingHashAlgorithms": [],
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "PCOptimizerPro-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PC Optimizer Pro",
      "artifactName": "PCOptimizerPro-Setup-${version}.exe",
      "perMachine": false,
      "unicode": true,
      "differentialPackage": false
    },
    "extraMetadata": {
      "main": "electron/main.cjs"
    }
  }
}
